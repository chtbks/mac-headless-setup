# OpenClaw config — generated by MacSetup from templates/openclaw.config.yaml.tmpl
#
# WARNING: This schema is transcribed from docs/openclaw-ios-agent-setup-v1.md
# and is UNVERIFIED against the real `openclaw init` output. Treat it as a
# starting scaffold. scripts/90-openclaw.sh will diff it against whatever
# `openclaw init` actually generates and log the differences.
#
# Placeholders in ${...} are substituted at generation time.

platform:
  type: slack
  slack_bot_token: "${SLACK_BOT_TOKEN}"
  slack_app_token: "${SLACK_APP_TOKEN}"

plugins:
  - name: openclaw-code-agent
    enabled: true
    settings:
      parallel_execution: true
      isolation_mode: "worktree"
