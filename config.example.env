# config.example.env — copy to config.env and fill in, OR store these in
# LastPass (the scripts try LastPass first, then config.env, then prompt).
#
#   cp config.example.env config.env && $EDITOR config.env
#
# config.env is gitignored and MUST NOT be committed. Leave any value blank to
# be prompted for it at runtime (or to skip an optional step).

# --- Slack (create the app first; see README "Prerequisites") --------------
# Bot User OAuth Token, starts with xoxb-
SLACK_BOT_TOKEN=
# App-Level Token (Socket Mode), starts with xapp-
SLACK_APP_TOKEN=

# --- Tailscale --------------------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys
# Prefer a TAGGED key (e.g. tag:server) for a long-lived host. Leave blank to
# fall back to interactive Google-SSO login in a browser.
TS_AUTHKEY=

# --- GitHub -----------------------------------------------------------------
# Leave GITHUB_TOKEN blank to use the interactive `gh` device-flow login
# (recommended). Provide a fine-grained PAT (repo read/write, SSO-authorized for
# chtbks) only if you want a fully unattended login.
GITHUB_TOKEN=
# Global git identity for commits/PRs the agent makes on this box.
# Defaults to the dedicated Chatbooks QA machine user.
GIT_AUTHOR_NAME=Chatbooks QA
GIT_AUTHOR_EMAIL=qa@chatbooks.com

# --- Chatbooks build secrets ------------------------------------------------
# Keys the iOS build injects at build time (names match
# iphone/Secrets/Secrets.xcconfig.template). Persisted to ~/.chatbooks-build.env
# by scripts/85-app-secrets.sh. LastPass entry: MacSetup/google-places-api-key
GOOGLE_PLACES_API_KEY=

# --- Apple ID (for full Xcode via `xcodes`) ---------------------------------
# Leave blank to skip full Xcode and keep Command Line Tools only.
# NOTE: xcodes will still prompt for 2FA the first time.
XCODES_USERNAME=
XCODES_PASSWORD=

# --- LastPass entry names (only used if you rely on LastPass) ---------------
# These are the vault entry paths the scripts look up (see lib/common.sh
# get_secret calls). Defaults shown; change if your vault uses other names.
#   MacSetup/slack-bot-token
#   MacSetup/slack-app-token
#   MacSetup/tailscale-authkey
#   MacSetup/apple-id
